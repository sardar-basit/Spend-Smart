<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.spendsmart.ui.splash.SplashFragment"
        android:label="@string/app_name" />

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.spendsmart.ui.onboarding.OnboardingFragment"
        android:label="Onboarding" />

    <fragment
        android:id="@+id/lockFragment"
        android:name="com.example.spendsmart.ui.lock.LockFragment"
        android:label="@string/app_lock" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.spendsmart.ui.auth.LoginFragment"
        android:label="@string/login">
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.spendsmart.ui.auth.SignupFragment"
        android:label="@string/signup" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.spendsmart.ui.dashboard.DashboardFragment"
        android:label="@string/dashboard">
        <action
            android:id="@+id/action_dashboard_to_settings"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_dashboard_to_add"
            app:destination="@id/addTransactionFragment" />
        <action
            android:id="@+id/action_dashboard_to_savings"
            app:destination="@id/savingsFragment" />
        <action
            android:id="@+id/action_dashboard_to_split"
            app:destination="@id/splitBillsFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.spendsmart.ui.history.HistoryFragment"
        android:label="@string/history">
        <action
            android:id="@+id/action_history_to_add"
            app:destination="@id/addTransactionFragment" />
    </fragment>

    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.example.spendsmart.ui.budget.BudgetFragment"
        android:label="@string/budget_setup" />

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.example.spendsmart.ui.stats.StatsFragment"
        android:label="@string/stats" />

    <fragment
        android:id="@+id/savingsFragment"
        android:name="com.example.spendsmart.ui.savings.SavingsFragment"
        android:label="@string/savings_goals" />

    <fragment
        android:id="@+id/splitBillsFragment"
        android:name="com.example.spendsmart.ui.split.SplitBillsFragment"
        android:label="@string/split_bills" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.spendsmart.ui.settings.SettingsFragment"
        android:label="@string/settings">
        <action
            android:id="@+id/action_settings_to_savings"
            app:destination="@id/savingsFragment" />
        <action
            android:id="@+id/action_settings_to_split"
            app:destination="@id/splitBillsFragment" />
        <action
            android:id="@+id/action_settings_to_budget"
            app:destination="@id/budgetFragment" />
    </fragment>

    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.example.spendsmart.ui.addtransaction.AddTransactionFragment"
        android:label="@string/add_transaction">
        <argument
            android:name="transactionId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>
</navigation>
